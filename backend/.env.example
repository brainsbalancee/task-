# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Data ----
# Source dataset (CSV) consumed by the ETL step.
DATA_CSV=../data/linkedin_profiles.csv
# SQLite database file produced by the ETL step.
SQLITE_PATH=./data/profiles.db

# ---- Search engine ----
# "sqlite"  -> zero-config, uses SQLite FTS5 (BM25). Default.
# "elastic" -> uses Elasticsearch (run `npm run es:up` from the repo root first).
SEARCH_ENGINE=sqlite

# Only used when SEARCH_ENGINE=elastic
ELASTIC_NODE=http://localhost:9200
ELASTIC_INDEX=profiles
