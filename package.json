{
  "name": "task",
  "version": "1.0.0",
  "private": true,
  "description": "task — a search engine over a LinkedIn profile dataset (Cyberyan full-stack trial task)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && npm run ingest",
    "ingest": "npm run ingest --workspace backend",
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "es:up": "docker compose up -d elasticsearch || docker-compose up -d elasticsearch",
    "es:down": "docker compose down || docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
